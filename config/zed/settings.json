{
  "show_edit_predictions": false,
  "agent": {
    "default_model": {
      "enable_thinking": false,
      "provider": "opencode",
      "model": "go/qwen3.7-plus"
    },
    "use_modifier_to_send": false,
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "language_models": {
    "opencode": {
      "show_free_models": false,
      "show_zen_models": false,
      "show_go_models": true
    },
    "ollama": {
      "api_url": "http://ollama.com",
      "model": "glm-5.2:cloud",
      "prompt_format": "infer",
      "max_output_tokens": 16000
    }
  },
  "base_keymap": "Zed",
  "vim_mode": true,
  "vim": {
    "default_mode": "normal",
    "cursor_shape": {
      "normal": "block",
      "replace": "underline",
      "visual": "block",
      "insert": "bar"
    },
    "use_smartcase_find": true,
    "use_system_clipboard": "on_yank",
    "use_regex_search": true,
    "gdefault": true,
    "highlight_on_yank_duration": 200,
    "show_edit_predictions_in_normal_mode": false,
    "toggle_relative_line_numbers": false
  },
  "relative_line_numbers": "enabled",
  "cursor_shape": "bar",
  "cursor_blink": false,
  "autosave": "on_focus_change",
  "restore_on_startup": "launchpad",
  "confirm_quit": true,
  "vertical_scroll_margin": 10,
  "scroll_beyond_last_line": "off",
  "scrollbar": {
    "show": "never"
  },
  "use_smartcase_search": true,
  "sticky_scroll": {
    "enabled": false
  },
  "ui_font_family": "Inter",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14,
  "terminal": {
    "scroll_multiplier": 4.0,
    "alternate_scroll": "off"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "restore_unsaved_buffers": false,
    "trust_all_worktrees": true
  },
  "minimap": {
    "show": "always"
  },
  "preview_tabs": {
    "enable_preview_from_project_panel": false,
    "enable_preview_file_from_code_navigation": false,
    "enable_preview_from_multibuffer": false
  },
  "diff_view_style": "unified",
  "format_on_save": "off",
  "soft_wrap": "editor_width",
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 400
    }
  },
  "project_panel": {
    "dock": "left",
    "starts_open": false,
    "entry_spacing": "standard"
  },
  "collaboration_panel": {
    "button": false
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "mode": "subtle"
  },
  "theme": "Vesper",
  "command_aliases": {
    "W": "w",
    "Wq": "wq",
    "Wqa": "wqa",
    "Q": "q"
  }
}
