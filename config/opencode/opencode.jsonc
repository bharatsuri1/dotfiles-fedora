{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  // Never share sessions to opencode.ai
  "share": "disabled",
  // Updates belong to the platform setup/update workflow
  "autoupdate": false,
  // Skip noisy directories in the file watcher
  "watcher": {
    "ignore": ["node_modules/**", ".git/**", "dist/**", "target/**"]
  },
  // Save context on long sessions by pruning old tool outputs
  "compaction": {
    "auto": true,
    "prune": true
  }
}
