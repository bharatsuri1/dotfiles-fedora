input {
    keyboard {
        xkb {}
        repeat-delay 200
        repeat-rate 35
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-speed 0.2
        scroll-factor 0.3
        click-method "clickfinger"
    }

    focus-follows-mouse
}

output "eDP-1" {
    mode "2560x1600@120.002"
    scale 1.5
    position x=0 y=0
}

layout {
    gaps 12
    background-color "#101010"
    center-focused-column "on-overflow"
    always-center-single-column
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 1.0; }
    focus-ring {
        width 2
        active-color "#ffc799"
        inactive-color "#505050"
        urgent-color "#f5a191"
    }
    border {
        off
    }
    shadow {
        on
        softness 24
        spread 3
        offset x=0 y=4
        draw-behind-window true
        color "#00000050"
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 6
        width 3
        length total-proportion=0.35
        position "top"
        active-color "#ffc799"
        inactive-color "#505050"
        urgent-color "#f5a191"
    }
}

prefer-no-csd

window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// Keep browser video useful without disrupting the scrolling layout.
window-rule {
    match app-id=r#"^(chromium-browser|firefox|org\.mozilla\.firefox)$"# title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

window-rule {
    match app-id="^dev\\.tensaku\\.Tensaku$"
    open-floating true
}

overview {
    backdrop-color "#101010"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

debug {
    honor-xdg-activation-with-invalid-serial
}

binds {
    Mod+Shift+Slash repeat=false { show-hotkey-overlay; }

    Mod+T repeat=false hotkey-overlay-title="Open Alacritty" { spawn "alacritty"; }
    Mod+Ctrl+T repeat=false hotkey-overlay-title="Open Herdr" { spawn "alacritty" "--class" "Herdr" "--title" "Herdr" "-e" "herdr"; }
    Mod+Space repeat=false hotkey-overlay-title="Open Fuzzel" { spawn "fuzzel"; }
    Mod+B repeat=false hotkey-overlay-title="Open Chromium" { spawn "chromium-browser"; }
    Mod+Ctrl+C repeat=false hotkey-overlay-title="Open ChatGPT" { spawn "chromium-browser" "--app=https://chatgpt.com/"; }
    Mod+Ctrl+Y repeat=false hotkey-overlay-title="Open YouTube" { spawn "chromium-browser" "--app=https://youtube.com/"; }
    Mod+Ctrl+G repeat=false hotkey-overlay-title="Open GitHub" { spawn "chromium-browser" "--app=https://github.com/"; }
    Mod+E repeat=false hotkey-overlay-title="Open Files" { spawn "nautilus" "--new-window"; }
    Mod+Ctrl+Z repeat=false hotkey-overlay-title="Open Zed" { spawn "flatpak" "run" "dev.zed.Zed"; }
    Mod+Ctrl+V repeat=false hotkey-overlay-title="Open Visual Studio Code" { spawn "flatpak" "run" "com.visualstudio.code"; }
    Mod+Ctrl+S repeat=false hotkey-overlay-title="Open LocalSend" { spawn "flatpak" "run" "org.localsend.localsend_app"; }

    Mod+Ctrl+Comma repeat=false hotkey-overlay-title="Dismiss All Notifications" { spawn "makoctl" "dismiss" "--all"; }

    // Local dictation (Voxtype). Hyper is Caps held via keyd (Ctrl+Alt+Super+Shift).
    // niri has no key-release binds, so toggle mode is used instead of hold/release.
    Mod+Ctrl+Alt+Shift+S repeat=false hotkey-overlay-title="Toggle Dictation" { spawn "voxtype" "record" "toggle"; }
    Escape repeat=false hotkey-overlay-title="Cancel Dictation" { spawn "voxtype" "record" "cancel"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1+" "-l" "1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMute repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute repeat=false allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay repeat=false allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause repeat=false allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioStop repeat=false allow-when-locked=true { spawn "playerctl" "stop"; }
    XF86AudioPrev repeat=false allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext repeat=false allow-when-locked=true { spawn "playerctl" "next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+L repeat=false allow-inhibiting=false hotkey-overlay-title="Lock Screen" { spawn "lock-screen"; }

    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-or-monitor-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-or-monitor-right; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right-or-to-monitor-right; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+R repeat=false { switch-preset-column-width; }
    Mod+Shift+R repeat=false { switch-preset-column-width-back; }
    Mod+Ctrl+R repeat=false { reset-window-height; }
    Mod+Ctrl+Shift+R repeat=false { switch-preset-window-height; }
    Mod+BracketLeft repeat=false { consume-or-expel-window-left; }
    Mod+BracketRight repeat=false { consume-or-expel-window-right; }
    Mod+C repeat=false { center-column; }
    Mod+F repeat=false { maximize-column; }
    Mod+Shift+F repeat=false { fullscreen-window; }
    Mod+M repeat=false { maximize-window-to-edges; }
    Mod+V repeat=false { toggle-window-floating; }
    Mod+Shift+V repeat=false { switch-focus-between-floating-and-tiling; }
    Mod+W repeat=false { toggle-column-tabbed-display; }

    Mod+Shift+4 repeat=false hotkey-overlay-title="Capture Region" { spawn "take-screenshot" "region"; }
    Mod+Shift+5 repeat=false hotkey-overlay-title="Native Screenshot UI" { screenshot; }
    Mod+Shift+6 repeat=false hotkey-overlay-title="Capture Screen" { spawn "take-screenshot" "screen"; }
    Mod+Shift+7 repeat=false hotkey-overlay-title="Capture Window" { spawn "take-screenshot" "window"; }
    Mod+Shift+S repeat=false hotkey-overlay-title="Capture and Annotate" { spawn "take-screenshot" "region" "--edit"; }

    Mod+Escape repeat=false allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E repeat=false { quit; }
    Ctrl+Alt+Delete repeat=false { quit; }
    Mod+Shift+P repeat=false { power-off-monitors; }
}
