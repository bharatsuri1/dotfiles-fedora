#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly LIB_DIR="$REPO_ROOT/lib/laptop-setup"

for module in \
  common \
  packages \
  development \
  herdr \
  docker \
  desktop-foundation \
  desktop-defaults \
  niri \
  dms \
  keyd \
  fonts \
  flatpaks \
  homebrew \
  shell-tools \
  config \
  shell \
  status; do
  # shellcheck source=/dev/null
  source "$LIB_DIR/$module.sh"
done
unset module

usage() {
  cat <<'USAGE'
Usage: laptop-setup [--dry-run] [--yes] COMMAND

Commands:
  status      Report installed and managed state
  apply       Run every setup phase in dependency order
  packages    Install missing Fedora-native packages
  development Install Mise and uv runtime tooling
  herdr      Install Herdr using its official verified installer
  docker      Install Docker Engine, Buildx, and Compose
  desktop-foundation
              Install compositor-independent desktop foundations
  desktop-defaults
              Configure browser, file, media, image, and PDF handlers
  niri        Install niri from the DMS COPR
  dms         Install DMS and attach it to niri
  keyd        Install keyd and configure Caps as Escape/Hyper
  fonts       Install terminal and desktop fallback fonts
  font        Alias for fonts (deprecated)
  flatpaks    Configure Flathub and install LocalSend
  homebrew    Install Homebrew if needed, then Dashlane CLI and managed formulae
  shell-tools Install pinned Zsh plugins directly without a plugin manager
  config      Back up conflicts and link the managed configuration
  shell       Change the login shell to Zsh after confirmation
USAGE
}

main() {
  while (($#)); do
    case "$1" in
      --dry-run) DRY_RUN=true; shift ;;
      --yes|-y) ASSUME_YES=true; shift ;;
      --help|-h) usage; return ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done

  local command="${1:-apply}"
  (($# <= 1)) || die 'only one command may be supplied'
  require_fedora

  case "$command" in
    status) show_status ;;
    apply)
      install_packages
      install_development_tools
      install_herdr
      install_docker
      install_desktop_foundation
      install_niri
      install_dms
      install_keyd
      install_fonts
      install_flatpaks
      install_homebrew
      install_shell_tools
      install_config
      install_desktop_defaults
      set_shell
      ;;
    packages) install_packages ;;
    development) install_development_tools ;;
    herdr) install_herdr ;;
    docker) install_docker ;;
    desktop-foundation) install_desktop_foundation ;;
    desktop-defaults) install_desktop_defaults ;;
    niri) install_niri ;;
    dms) install_dms ;;
    keyd) install_keyd ;;
    fonts|font) install_fonts ;;
    flatpaks) install_flatpaks ;;
    homebrew) install_homebrew ;;
    shell-tools) install_shell_tools ;;
    config) install_config ;;
    shell) set_shell ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"
