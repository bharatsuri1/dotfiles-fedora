#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "$REPO_ROOT/lib/wallpaper.sh"

exec swaybg \
  --image "$(current_wallpaper)" \
  --mode fill
