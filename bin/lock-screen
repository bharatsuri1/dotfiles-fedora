#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "$REPO_ROOT/lib/wallpaper.sh"

exec gtklock \
  --daemonize \
  --config "$REPO_ROOT/config/gtklock/config.ini" \
  --layout "$REPO_ROOT/config/gtklock/layout.ui" \
  --style "$REPO_ROOT/config/gtklock/style.css" \
  --background "$(current_wallpaper)"
