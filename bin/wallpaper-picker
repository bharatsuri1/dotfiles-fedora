#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly REPO_ROOT="$(cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd)"
# shellcheck source=/dev/null
source "$REPO_ROOT/lib/wallpaper.sh"

readonly SDDM_BACKGROUND_TARGET="/usr/share/sddm/themes/vesper/background.png"

initialize_wallpapers
readonly WALLPAPERS_DIR="$(wallpapers_dir)"
mapfile -t wallpapers < <(find "$WALLPAPERS_DIR" -maxdepth 1 -type f \
  \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
  -printf '%f\n' | sort)

((${#wallpapers[@]} > 0)) || {
  printf 'No wallpapers found in %s\n' "$WALLPAPERS_DIR" >&2
  exit 1
}

selection="$(printf '%s\n' "${wallpapers[@]}" | fuzzel --dmenu --prompt 'Wallpaper: ')"
[[ -n "$selection" ]] || exit 0

selected="$WALLPAPERS_DIR/$selection"
[[ -f "$selected" ]] || {
  printf 'Wallpaper disappeared: %s\n' "$selected" >&2
  exit 1
}

temporary_link="$WALLPAPERS_DIR/.current.$$"
ln -s -- "$selected" "$temporary_link"
mv -Tf -- "$temporary_link" "$WALLPAPERS_DIR/current"

systemctl --user restart swaybg.service
sudo install -D -m 0644 -- "$selected" "$SDDM_BACKGROUND_TARGET"
