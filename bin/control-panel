#!/usr/bin/env bash
set -Eeuo pipefail

# Toggle the control panel: close it if it is already open, otherwise
# launch it.  Bound to Super+Shift+C in the Niri config.
# Same toggle pattern as bin/fuzzel-toggle.

if pgrep -f "alacritty.*ControlPanel" >/dev/null 2>&1; then
  pkill -f "alacritty.*ControlPanel"
else
  tmux kill-session -t control-panel 2>/dev/null || true
  tmux new-session -d -s control-panel
  tmux send-keys -t control-panel "~/.config/sesh/scripts/control-panel.sh" Enter
  sleep 1
  exec alacritty \
    --class ControlPanel \
    --title "Control Panel" \
    -e tmux attach -t control-panel
fi