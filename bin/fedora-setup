#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly LIB_DIR="$REPO_ROOT/lib/fedora-setup"

for module in \
  common \
  packages \
  development \
  herdr \
  ollama \
  vicinae \
  docker \
  desktop-foundation \
  device-controls \
  system-tools \
  desktop-defaults \
  niri \
  screenshots \
  quickshell \
  sddm \
  keyd \
  fonts \
  flatpaks \
  zed \
  vscode \
  nvim \
  homebrew \
  shell-tools \
  config \
  shell \
  voxtype \
  status; do
  # shellcheck source=/dev/null
  source "$LIB_DIR/$module.sh"
done
unset module

usage() {
  cat <<'USAGE'
Usage: fedora-setup [--dry-run] [--yes] COMMAND

Commands:
  status      Report installed and managed state
  apply       Run every setup phase in dependency order
  packages    Install missing Fedora-native packages
  development Install Mise and uv runtime tooling
  herdr      Install Herdr using its official verified installer
  ollama      Install Ollama using its official installer
  vicinae     Install Vicinae using its official installer
  docker      Install Docker Engine, Buildx, and Compose
  desktop-foundation
              Install compositor-independent desktop foundations
  device-controls
              Install standalone network, Bluetooth, and audio TUIs
  system-tools
              Install system management TUIs (systemctl-tui, bandwhich, batctl, etc.)
  voxtype     Install and manage local Voxtype speech-to-text
  desktop-defaults
              Configure browser, file, media, image, and PDF handlers
  niri        Install niri from Fedora repositories
  screenshots Install screenshot capture tools and the managed Tensaku bundle
  quickshell  Install Quickshell from Fedora repositories
  sddm        Install and configure the Vesper-themed SDDM login screen
  sddm-enable Validate and enable SDDM for the next boot (explicit and guarded)
  keyd        Install keyd and configure Caps as Escape/Hyper
  fonts       Install terminal, system UI, and fallback fonts
  font        Alias for fonts (deprecated)
  flatpaks    Configure Flathub and install managed desktop applications
  zed         Link managed Zed settings and Vesper theme for the Flatpak app
  vscode     Link managed VS Code settings and keybindings for the Flatpak app
  nvim        Link managed LazyVim Neovim configuration
  homebrew    Install Homebrew if needed, then Dashlane CLI and managed formulae
  shell-tools Install pinned Zsh plugins directly without a plugin manager
  config      Back up conflicts and link the managed configuration
  shell       Change the login shell to Zsh after confirmation
USAGE
}

main() {
  while (($#)); do
    case "$1" in
      --dry-run) DRY_RUN=true; shift ;;
      --yes|-y) ASSUME_YES=true; shift ;;
      --help|-h) usage; return ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done

  local command="${1:-apply}"
  (($# <= 1)) || die 'only one command may be supplied'
  require_fedora

  case "$command" in
    status) show_status ;;
    apply)
      install_packages
      install_development_tools
      install_herdr
      install_ollama
      install_vicinae
      install_docker
      install_desktop_foundation
      install_device_controls
      install_system_tools
      install_voxtype
      install_niri
      install_screenshots
      install_quickshell
      install_keyd
      install_fonts
      install_sddm
      install_flatpaks
      install_zed
      install_vscode
      install_nvim
      install_homebrew
      install_shell_tools
      install_config
      install_desktop_defaults
      set_shell
      log 'SDDM is prepared but not implicitly enabled; run fedora-setup sddm-enable when ready'
      log 'Recovery path: switch to a TTY, log in, and run: niri-session'
      ;;
    packages) install_packages ;;
    development) install_development_tools ;;
    herdr) install_herdr ;;
    ollama) install_ollama ;;
    vicinae) install_vicinae ;;
    docker) install_docker ;;
    desktop-foundation) install_desktop_foundation ;;
    device-controls) install_device_controls ;;
    system-tools) install_system_tools ;;
    voxtype) install_voxtype ;;
    desktop-defaults) install_desktop_defaults ;;
    niri) install_niri ;;
    screenshots) install_screenshots ;;
    quickshell) install_quickshell ;;
    sddm) install_sddm ;;
    sddm-enable) enable_sddm ;;
    keyd) install_keyd ;;
    fonts|font) install_fonts ;;
    flatpaks) install_flatpaks ;;
    zed) install_zed ;;
    vscode) install_vscode ;;
    nvim) install_nvim ;;
    homebrew) install_homebrew ;;
    shell-tools) install_shell_tools ;;
    config) install_config ;;
    shell) set_shell ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"
